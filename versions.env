# Pinned dependency versions: the one place to bump them. Read by dev/Makefile,
# CI, and the docs tests. After editing, run: cd operator && go run ./cmd/render-pins --root ..
# to rewrite the published examples and the chart image fields from these values.
# Format: KEY=value, no quotes, no spaces around "=", no $ expansion.
#
# These move together: Envoy AI Gateway v1.1.x uses Envoy Gateway v1.8.1 and
# Gateway API v1.5.1 (see https://aigateway.envoyproxy.io/docs/compatibility/).
# Bump them as a set when upgrading the AI Gateway.
CERT_MANAGER_VERSION=v1.17.2
GATEWAY_API_VERSION=v1.5.1
GIE_VERSION=v1.5.0
ENVOY_GATEWAY_VERSION=v1.8.1
AI_GATEWAY_VERSION=v1.1.0
# OpenMeter collector image the usage collector runs (written to usage.collector.image).
USAGE_COLLECTOR_IMAGE=ghcr.io/openmeterio/benthos-collector:v1.0.0-beta.234@sha256:cdc35416af4ededfbdb531463a3135127274f595c4b4b44573e685e82aac4fc4
# OpenMeter API and sink worker image (written to openmeter.image of the nebari-openmeter subchart).
OPENMETER_IMAGE=ghcr.io/nebari-dev/openmeter:v1.0.0-beta.234-nebari.1@sha256:be471cd4036270c1f6c6979974bfcc7d6b03a46809a20fe3c6c72b45d0c12b22
# CloudNativePG operator chart and image tag (the bundled OpenMeter's Postgres is a CloudNativePG Cluster).
# Chart 0.29.1 ships operator 1.30.1, which fixes CVE-2026-84304 (gRPC) in 1.30.0.
CNPG_CHART_VERSION=0.29.1
CNPG_IMAGE_TAG=1.30.1@sha256:923c267ec29636db3bee20f993d0ec4973fa22998e1adad37da79e4d32b5bc07
